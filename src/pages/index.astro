---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeCard from "../components/HomeCard.astro";
const allPosts = Object.values(import.meta.glob('./blog/posts/*.md',{eager:true}))
allPosts.sort((b:any,a:any)=>a.frontmatter.pubDate.localeCompare(b.frontmatter.pubDate) || b.frontmatter.pubDate.localeCompare(a.frontmatter.pubDate))
allPosts.length = 3;
---
<BaseLayout pageTitle="Home">
    <header>
        <img src="https://picsum.photos/id/61/1600/900" alt="">
    </header>
    <h1>最新文章</h1>
    <div class="container">
        {
            allPosts.map((post:any)=>
            <div class="col">
                <HomeCard post={post.frontmatter} url={post.url}></HomeCard>
            </div>)
        }
    </div>
</BaseLayout>
<style>
    .col {
        width: 100%;
    }
    header {
        aspect-ratio: 2 / 1;
        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        margin-bottom: 100px;
    }
</style>