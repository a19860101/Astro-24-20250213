---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from '../../components/Card.astro'

const allPosts = Object.values(import.meta.glob('./posts/*.md',{eager: true}))
allPosts.sort((b:any,a:any)=>a.frontmatter.pubDate.localeCompare(b.frontmatter.pubDate) || b.frontmatter.pubDate.localeCompare(a.frontmatter.pubDate))
---
<BaseLayout pageTitle="Blog">
    <h1>Blog</h1>

    <!-- <ul>
        <li><a href="blog/posts/post-1">Post 1</a></li>
        <li><a href="blog/posts/post-2">Post 2</a></li>
    </ul> -->
    <div class="container">
    {
        allPosts.map((post:any) => 
            <div class="col">
                <Card post={post.frontmatter} url={post.url}></Card>
            </div>
            )
    }
    </div>
</BaseLayout>