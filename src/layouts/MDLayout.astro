---
import BaseLayout from "./BaseLayout.astro"
const {frontmatter} = Astro.props
---
<BaseLayout>
    <article>
        <h1>{frontmatter.title}</h1>
        <div>作者:{frontmatter.author}</div>
        <div>發布日期:{frontmatter.pubDate}</div>
        <slot />
        <div>
            <a href="/blog">文章列表</a>
        </div>
    </article>
</BaseLayout>
<style>
    article {
        width: 800px;
        margin: auto;
    }
    h1 {
        font-size:48px;
        padding: 30px;
        text-align: center;
    }
</style>
