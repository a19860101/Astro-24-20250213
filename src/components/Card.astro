---
import Tag from "./Tag.astro"
const {post, url} = Astro.props
---
<div class="card">
    <div class="card-img">
        <img src={post.image.src} alt="" class="cover">
    </div>
    <div class="card-body">
        <small>{post.pubDate.slice(0,10)}</small>
        <h3>{post.title}</h3>
        <div>
            <!-- <small>
                {post.tags.join(',')}
            </small> -->
            {
                post.tags.map((tag:any) => <Tag tag={tag}></Tag>)
            }
        </div>
        <a href={url} class="card-btn">繼續閱讀</a>
    </div>
</div>